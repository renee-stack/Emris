# Copy to deploy/.env, which git ignores. Placeholders only: never commit real values.

# Required. Emris sends this as the x-redline-key header. Make one with: openssl rand -hex 32
REDLINE_API_KEY=replace-with-a-long-random-value
# The port published on the host. With compose.gcp.yaml, use 127.0.0.1:8792 so only Caddy can reach it.
REDLINE_PUBLIC_PORT=8792
# The Google Cloud project that has Claude enabled in Vertex AI's Model Garden.
VERTEX_PROJECT_ID=your-project-id
VERTEX_REGION=global
# Overrides the model in agent/agent.json, as a Vertex model id, e.g. claude-haiku-4-5@20251001.
REDLINE_MODEL=
# Leave both empty to keep unlocking as the free design-partner offer.
STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
# For compose.gcp.yaml: the name Caddy gets a certificate for, e.g. 136-119-7-65.sslip.io.
REDLINE_DOMAIN=
