# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: one .env at the repo root, never committed (web/.env.local is a symlink to it)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
.venv/
__pycache__/
*.pyc

# local caches
.cache/
