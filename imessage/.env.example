# Photon Spectrum credentials (app.photon.codes → project Settings)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Where the Emris API lives (this service POSTs to {EMRIS_API_URL}/api/ask)
EMRIS_API_URL=http://localhost:3000

# Public base URL used in texted links: {EMRIS_PUBLIC_URL}{url}
# Falls back to APP_BASE_URL (contract §5), then EMRIS_API_URL.
EMRIS_PUBLIC_URL=http://localhost:3000
