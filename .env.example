# Copy to .env (never commit .env).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used for Stripe success/cancel and invite links
APP_BASE_URL=http://localhost:3000

# Stripe (test mode until go-live). Checkout creates missing catalog prices on first use.
# Optional ahead-of-time: npm run stripe:setup
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email (team invites + enterprise contact)
# RESEND_API_KEY=
# CONTACT_FROM=Emris <onboarding@resend.dev>
# CONTACT_EMAIL=renee@lumina.house
